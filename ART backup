const firebaseConfig={apiKey:"AIzaSyCnXtAS1tYpV7bpEh_wWF4vtWSZFljH9eA",authDomain:"as-editz-website.firebaseapp.com",projectId:"as-editz-website",storageBucket:"as-editz-website.firebasestorage.app",messagingSenderId:"995496657434",appId:"1:995496657434:web:21df69553f88885eeb07a3"};
const OWNER_EMAILS=["mahapatrasubrat165@gmail.com","jagankumarnayakamit@gmail.com"].map(v=>v.toLowerCase());
let auth=null,db=null,currentUser=null;
const app=initializeApp(firebaseConfig);auth=getAuth(app);db=getFirestore(app);
const $=id=>document.getElementById(id);
function isOwner(u){return !!u&&OWNER_EMAILS.includes((u.email||'').toLowerCase())}
function closeAccount(){const p=$('accountPopover');p.classList.remove('show');p.setAttribute('aria-hidden','true')}
function renderAccount(user){
 const navActions=document.querySelector('.nav-actions');
 navActions.querySelectorAll('.account-avatar-btn,.owner-round-btn').forEach(x=>x.remove());
 const login=$('loginNavBtn');
 if(!user){login.style.display='grid';closeAccount();$('ownerControlBtn').style.display='none';return}
 login.style.display='none';
 const avatar=document.createElement('button');avatar.type='button';avatar.className='round-btn account-avatar-btn';avatar.title='Account profile';avatar.setAttribute('aria-label','Account profile');
 if(user.photoURL){const im=document.createElement('img');im.src=user.photoURL;im.alt='';im.referrerPolicy='no-referrer';avatar.appendChild(im)}else{avatar.textContent=(user.displayName||user.email||'A').trim().charAt(0).toUpperCase()}
 avatar.addEventListener('click',e=>{e.stopPropagation();$('accountName').textContent=user.displayName||'Signed in';$('accountEmail').textContent=user.email||'';const p=$('accountPopover');p.classList.toggle('show');p.setAttribute('aria-hidden',p.classList.contains('show')?'false':'true')});
 navActions.prepend(avatar);
 if(isOwner(user)){
   const ownerBtn=document.createElement('button');ownerBtn.type='button';ownerBtn.className='round-btn owner-round-btn';ownerBtn.title='Owner Control';ownerBtn.setAttribute('aria-label','Owner Control');ownerBtn.innerHTML='<svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm9 5v-2l-2.1-.7a7.5 7.5 0 0 0-.7-1.7l1-2-1.4-1.4-2 1a7.5 7.5 0 0 0-1.7-.7L13.5 3h-2l-.7 2.1a7.5 7.5 0 0 0-1.7.7l-2-1L5.7 6.2l1 2a7.5 7.5 0 0 0-.7 1.7L4 10.5v2l2.1.7a7.5 7.5 0 0 0 .7 1.7l-1 2 1.4 1.4 2-1a7.5 7.5 0 0 0 1.7.7l.7 2.1h2l.7-2.1a7.5 7.5 0 0 0 1.7-.7l2 1 1.4-1.4-1-2a7.5 7.5 0 0 0 .7-1.7Z"/></svg>';
   ownerBtn.addEventListener('click',()=>{closeAccount();openModal('ownerModal')});navActions.prepend(ownerBtn);
 }
 $('ownerControlBtn').style.display=isOwner(user)?'flex':'none';
}
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();const msg=$('loginMsg');msg.textContent='Signing in…';msg.style.color='#f5bd35';try{await signInWithEmailAndPassword(auth,$('loginEmail').value.trim(),$('loginPass').value);closeModal('loginModal');msg.textContent='';}catch(err){msg.textContent=err.code==='auth/operation-not-allowed'?'Enable Email/Password in Firebase Authentication.':'Sign-in failed. Check the email and password.';msg.style.color='#ff8d8d'}});
